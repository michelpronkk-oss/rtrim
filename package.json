{
  "name": "runtrim",
  "version": "0.1.30",
  "description": "The control layer for AI coding agents.",
  "license": "MIT",
  "author": "RunTrim",
  "homepage": "https://www.runtrim.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michelpronkk-oss/rtrim.git"
  },
  "bugs": {
    "url": "https://github.com/michelpronkk-oss/rtrim/issues"
  },
  "keywords": [
    "cli",
    "ai-coding",
    "coding-agents",
    "codex",
    "claude",
    "cursor",
    "mcp",
    "developer-tools",
    "agent-control",
    "code-safety",
    "ai-agents"
  ],
  "bin": {
    "runtrim": "dist-cli/runtrim.cjs"
  },
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:all",
    "build:web": "next build",
    "build:cli": "tsup --config tsup.config.ts && node scripts/verify-cli-build.mjs",
    "build:all": "npm run build:cli && npm run build:web",
    "verify:cli": "node scripts/verify-cli.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "node scripts/prepare-cli-package-manifest.mjs",
    "postpack": "node scripts/restore-package-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "publish:safe": "node scripts/safe-publish.mjs",
    "prepublishOnly": "npm run build:cli && npm run verify:package",
    "runtrim": "tsx cli/runtrim.ts",
    "runtrim:build": "npm run build:cli",
    "remotion:preview": "remotion preview src/remotion/index.ts",
    "remotion:render:landscape": "remotion render src/remotion/index.ts RunTrimDemoLandscape out/runtrim-demo-landscape.mp4",
    "remotion:render:square": "remotion render src/remotion/index.ts RunTrimDemoSquare out/runtrim-demo-square.mp4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/cli": "^4.0.456",
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/player": "^4.0.456",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.57.4",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clipboardy": "^5.3.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "dodopayments": "^2.32.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "ora": "^9.4.0",
    "prompts": "^2.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.456",
    "resend": "^6.12.2",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
